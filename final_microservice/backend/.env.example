ITEM_SERVICE_URL=http://localhost:3002
SEARCH_SERVICE_URL=http://localhost:3003
AI_ASSISTANT_SERVICE_URL=http://localhost:3004
ANALYTICS_SERVICE_URL=http://localhost:3005

# Environment
NODE_ENV=development

# CORS Settings
